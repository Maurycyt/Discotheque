     => ( X = null_class
        | singleton(Y) = X ) )

fof / number_of_elements_in_class :
    ! [X] :
      ( X = null_class
      | ? [Y] : singleton(Y) = X
      | ? [V] :
          ( member(V,X)
          & ? [W] : member(W,intersection(complement(singleton(V)),X)) ) )

