fof / rc3_relat_1 :
    ? [A] :
      ( relation(A)
      & relation_empty_yielding(A) )

fof / reflexivity_r1_tarski :
    ! [A,B] : subset(A,A)

fof / t1_subset :
    ! [A,B] :
      ( in(A,B)
     => element(A,B) )

fof / t20_funct_1 :
    ! [A] :
      ( ( relation(A)
        & function(A) )
     => ! [B] :
          ( ( relation(B)
            & function(B) )
         => ! [C] :
              ( ( relation(C)
                & function(C) )
             => ( ( ! [D] :
                      ( in(D,relation_dom(C))
                    <=> ( in(D,relation_dom(A))
                        & in(apply(A,D),relation_dom(B)) ) )
                  & ! [D] :
                      ( in(D,relation_dom(C))
                     => apply(C,D) = apply(B,apply(A,D)) ) )
               => C = relation_composition(A,B) ) ) ) )

fof / t2_subset :
    ! [A,B] :
      ( element(A,B)
     => ( empty(B)
        | in(A,B) ) )

fof / t3_subset :
    ! [A,B] :
      ( element(A,powerset(B))
    <=> subset(A,B) )

fof / t4_subset :
    ! [A,B,C] :
      ( ( in(A,B)
        & element(B,powerset(C)) )
     => element(A,C) )

fof / t5_subset :
    ! [A,B,C] :
      ~ ( in(A,B)
        & element(B,powerset(C))
        & empty(C) )

fof / t6_boole :
    ! [A] :
      ( empty(A)
     => A = empty_set )

fof / t7_boole :
    ! [A,B] :
      ~ ( in(A,B)
        & empty(B) )

fof / t8_boole :
    ! [A,B] :
      ~ ( empty(A)
        & A != B
        & empty(B) )
